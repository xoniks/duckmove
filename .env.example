# Rename this file to .env and fill in your API tokens.
# .env is gitignored -- never commit real tokens.
#
# PyPI and TestPyPI are SEPARATE sites with separate accounts and separate
# tokens. A TestPyPI token will not work on PyPI, and vice versa. Each publish
# script reads only its own variable, so the two cannot be mixed up.
#
# You do not need TWINE_USERNAME or REPOSITORY any more: the scripts set the
# username to __token__ and hard-code their own target index.

# Used by scripts\publish-testpypi.ps1
# Create at: https://test.pypi.org/manage/account/token/
TESTPYPI_TOKEN=pypi-REPLACE_ME

# Used by scripts\publish-pypi.ps1
# Create at: https://pypi.org/manage/account/token/
PYPI_TOKEN=pypi-REPLACE_ME
